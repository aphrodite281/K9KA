                <mxCell id="71" value="已知a = T1+K1+T2+K2+T3+K3+T4+K4+T5&lt;br&gt;b = T1+T2+T3+T4+T5&lt;br&gt;c = a - b(K1+K2+K3+K4)&lt;br&gt;目标：使每个字的间隔一致&lt;br&gt;所以α=K1=K2=K3=K4&lt;br&gt;P&lt;sub&gt;T1&lt;/sub&gt;=0+0*α&lt;br&gt;P&lt;sub style=&quot;border-color: var(--border-color);&quot;&gt;T1&lt;/sub&gt;=T1+1*α&lt;br&gt;P&lt;sub style=&quot;border-color: var(--border-color);&quot;&gt;T3&lt;/sub&gt;=T1+T2+2*α" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
